{
  "name": "blastmap",
  "version": "0.1.0-rc.1",
  "description": "Local-first change blast-radius mapper for AI coding workflows — import graph, reverse dependents, test pairing, risk scoring, bilingual reports.",
  "type": "module",
  "license": "MIT",
  "author": "flower1201",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flower1201/blastmap.git"
  },
  "bugs": {
    "url": "https://github.com/flower1201/blastmap/issues"
  },
  "homepage": "https://github.com/flower1201/blastmap#readme",
  "keywords": [
    "blast-radius",
    "import-graph",
    "git-diff",
    "typescript",
    "cli",
    "ai-coding",
    "impact-analysis",
    "local-first"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "bin": {
    "blastmap": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node scripts/demo.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
